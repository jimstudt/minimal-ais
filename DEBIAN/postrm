#!/bin/sh
set -e

case "$1" in
    remove|purge|disappear)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl reset-failed minimal-ais-serial.service || true
            systemctl reset-failed minimal-ais-json.service || true
        fi
        ;;
esac

exit 0
